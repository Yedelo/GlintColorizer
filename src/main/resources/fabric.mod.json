{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"Polyfrost",
		"lowercasebtw"
	],
	"contributors": [
	],
	"contact": {
		"homepage": "https://github.com/Polyfrost/${mod_name}",
		"sources": "https://github.com/Polyfrost/${mod_name}",
		"issues": "https://github.com/Polyfrost/${mod_name}/issues"
	},
	"license": "${license}",
	"icon": "assets/${mod_id}/glintcolorizer_dark.svg",
	"environment": "client",
	"entrypoints": {
		"client": [
			"org.polyfrost.glintcolorizer.GlintColorizer"
		]
	},
	"mixins": [
		"glintcolorizer.mixins.json5"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version_range}",
		"oneconfigv1": ">=${oneconfig_version}"
	}
}
